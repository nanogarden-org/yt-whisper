{
  "manifest_version": 3,
  "name": "YT Whisper Queue",
  "version": "0.1.0",
  "description": "Right-click a link and append it to a local yt-whisper queue.",
  "permissions": [
    "contextMenus",
    "notifications"
  ],
  "host_permissions": [
    "http://127.0.0.1:8765/*"
  ],
  "background": {
    "service_worker": "background.js"
  }
}